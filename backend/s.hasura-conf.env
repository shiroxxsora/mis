POSTGRES_USER=hasurapg
POSTGRES_PASSWORD=hasurapg
POSTGRES_DB=hasura-metadata

HASURA_GRAPHQL_METADATA_DATABASE_URL=postgres://hasurapg:hasurapg@hasura-db:5432/hasura-metadata
PG_DATABASE_URL=postgres://postgres:postgres@app-db:5432/app-mis
HASURA_GRAPHQL_ENABLE_CONSOLE="true"
HASURA_GRAPHQL_DEV_MODE="true"
HASURA_GRAPHQL_ENABLED_LOG_TYPES=startup, http-log, webhook-log, websocket-log, query-log
HASURA_GRAPHQL_METADATA_DEFAULTS='{"backend_configs":{"dataconnector":{"athena":{"uri":"http://hasura-data-connector-agent:8081/api/v1/athena"},"mariadb":{"uri":"http://hasura-data-connector-agent:8081/api/v1/mariadb"},"mysql8":{"uri":"http://hasura-data-connector-agent:8081/api/v1/mysql"},"oracle":{"uri":"http://hasura-data-connector-agent:8081/api/v1/oracle"},"snowflake":{"uri":"http://hasura-data-connector-agent:8081/api/v1/snowflake"}}}}'
HASURA_GRAPHQL_ADMIN_SECRET=myadminsecretkey

QUARKUS_LOG_LEVEL=ERROR
QUARKUS_OPENTELEMETRY_ENABLED="false"