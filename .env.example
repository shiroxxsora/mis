# Скопируйте в .env и задайте свои значения: cp .env.example .env

# Keycloak (master admin + демо-пользователь создаётся скриптом scripts/keycloak-create-demo-user.sh)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# Hasura — обязательно смените в production
HASURA_ADMIN_SECRET=changeme
# Для production задайте HASURA_GRAPHQL_DEV_MODE=false
HASURA_GRAPHQL_DEV_MODE=true
# RS256 JWT от Keycloak realm mis (jwk_url — внутренний DNS Docker).
# x-hasura-default-role фиксирован как user; клиент передаёт x-hasura-role по MIS-роли из JWT.
# В realm_access.roles также попадают служебные роли Keycloak (offline_access и т.д.) —
# для production добавьте mapper с отфильтрованным claim (только user/registrar).
HASURA_GRAPHQL_JWT_SECRET={"type":"RS256","jwk_url":"http://keycloak:8080/realms/mis/protocol/openid-connect/certs","issuer":"http://localhost:8180/realms/mis","claims_map":{"x-hasura-allowed-roles":{"path":"$.realm_access.roles"},"x-hasura-default-role":"user","x-hasura-user-id":{"path":"$.sub"}}}

# API Gateway — JWT проверяется только здесь; service-logic в закрытой Docker-сети
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/mis
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/mis/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=mis-frontend
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173

# LLM summary (локальный endpoint)
LLM_API_URL=http://host.docker.internal:1234/api/v1/chat
LLM_MODEL=qwen/qwen3.5-9b
LLM_SYSTEM_PROMPT=Ты медицинский ассистент. Отвечай кратко на русском, структурируй вывод: жалобы, динамика, лечение, риски.
LLM_ATTENDANCE_SYSTEM_PROMPT=Ты аналитик стоматологической клиники. По истории записей пациента оцени вероятность его явки на следующий приём. Учитывай количество явок, пропусков и отмен. Ответь только целым числом от 0 до 100 — процент вероятности явки, без пояснений.
LLM_CONNECT_TIMEOUT_SECONDS=30
LLM_READ_TIMEOUT_SECONDS=600
ATTENDANCE_BACKFILL_ENABLED=true
ATTENDANCE_BACKFILL_PATIENTS_LIMIT=25
ATTENDANCE_BACKFILL_APPOINTMENTS_LIMIT=10

# MinIO (S3-compatible object storage для снимков пациентов)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=mis-patient-images
# Внутри Docker service-logic использует http://minio:9000; с хоста — http://localhost:9000
MINIO_ENDPOINT=http://localhost:9000

# Recognition service (SHAP + LIME; на CPU может занять 30–90 с — включайте при необходимости)
EXPLAIN_ON_INFERENCE=true
LIME_NUM_SAMPLES=150
LIME_NUM_FEATURES=8
SHAP_BACKGROUND=8

# npm mirror (опционально)
# NPM_REGISTRY=https://registry.npmmirror.com
