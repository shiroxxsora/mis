# === Пути ===
# Папка с Original Dataset (jpg + txt YOLO аннотации)
DATASET_DIR=../../Dental OPG XRAY Dataset/Dental OPG (Object Detection)/Original Dataset
OUTPUT_DIR=./output

# === Кропинг ===
SKIP_CROP=false          # true — пропустить кроп, использовать готовый CSV
MIN_CROP_SIZE=10         # минимальный размер кропа в пикселях

# Классы из OD датасета:
#   0: Caries  1: Infection  2: Impacted  3: Fractured  4: BDC-BDR  5: Healthy
UNHEALTHY_CLASSES=2,4    # Impacted + BDC-BDR → 0 (Unhealthy)
HEALTHY_CLASSES=5        # Healthy             → 1 (Healthy)

# === Модель ===
FILTERS=16,32,64,128
FC_UNITS=128
DROPOUT=0.5
LEARNING_RATE=5e-4
USE_ATTENTION=true
USE_SCHEDULER=true

# === Обучение ===
IMG_SIZE=128
EPOCHS=50
BATCH_SIZE=32
DROPOUT_SWEEP=false      # true — обучает 3 модели (dropout=0.2/0.3/0.5), выбирает лучшую
VAL_SPLIT=0.2
SEED=42
DEVICE=cpu               # cpu / cuda
