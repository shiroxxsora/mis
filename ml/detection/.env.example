DATASET_PATH=../../Dental OPG XRAY Dataset/Dental OPG (Object Detection)/Augmented Dataset
OUTPUT_PATH=./output

# yolov8n / yolov8s / yolov8m / yolov8l / yolov8x
# n — быстрее, x — точнее
MODEL_NAME=yolov8m.pt

EPOCHS=100
IMAGE_SIZE=640
BATCH_SIZE=8
PATIENCE=20
WORKERS=4

LR0=0.003
LRF=0.01
WEIGHT_DECAY=0.0005

# Аугментация (OPG — рентген, поэтому отключаем цветовые и flipud)
MOSAIC=0.5
DEGREES=5
TRANSLATE=0.05
SCALE=0.3
FLIPLR=0.5
FLIPUD=0.0
HSV_V=0.3
HSV_S=0.0
HSV_H=0.0

INFER_CONF=0.25
RUN_INFER_SAMPLES=true

# Объяснимость (GradCAM-style activation map + bbox overlay)
RUN_EXPLAIN=true
EXPLAIN_SAMPLES=6
