DATASET_PATH=../Dental OPG XRAY Dataset/Dental OPG (Classification)
OUTPUT_PATH=./training/output

# --- Рекомендуемые настройки для ResNet18 + ~500 снимков ---
MODEL_BACKBONE=resnet18
PRETRAINED=true
LEARNING_RATE=0.0003
BACKBONE_LR_RATIO=0.1
FINETUNE_LR_FACTOR=0.5
FREEZE_ENCODER_EPOCHS=10
BATCH_SIZE=16
EPOCHS=80
WEIGHT_DECAY=0.001
MIXUP_ALPHA=0.2

USE_CLASS_WEIGHTS=true
CLASS_WEIGHT_POWER=0.5
CLASS_WEIGHT_MAX_RATIO=4
USE_WEIGHTED_SAMPLER=false
LOSS_TYPE=cross_entropy
LABEL_SMOOTHING=0

EARLY_STOP_PATIENCE=15
IMAGE_SIZE=224
VAL_RATIO=0.2
NUM_WORKERS=0
SEED=42
DEVICE=cuda

# Мягкая аугментация (сильная ломает маленький датасет)
AUGMENT_ENABLED=true
AUGMENT_ROTATION=8
AUGMENT_RANDOM_ERASING=false

RUN_EXPLAIN=true
EXPLAIN_SAMPLES=3
LIME_NUM_SAMPLES=300
